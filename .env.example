DATABASE_URL=postgresql://user:password@localhost:5432/dbname?sslmode=disable
TUTOR_ROOT=/absolute/path/to/Personal AI assistant
PYTHON_PATH=/usr/bin/python3
PORT=3000

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:4200

# Optional shared passcode. When set, every /api request must send a matching
# X-Access-Code header. Use this on public deployments to stop random traffic
# from burning your Anthropic/Gemini quota.
ACCESS_CODE=
